# TRACKORA Admin Portal — environment variables.
# Copy to .env and fill in values from Firebase Console > Project Settings.
# NEVER commit real keys.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Optional — future FastAPI backend (RF -> XGBRanker -> CP-SAT results).
# Leave empty until the backend exists; the portal works on Firestore alone.
VITE_API_BASE_URL=
